# Public client configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# Server-only Vercel/Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
SUPABASE_ADMIN_EMAILS=admin@example.com
# Set true only during migration from the old shared token.
ADMIN_ALLOW_LEGACY_TOKEN=false
ADMIN_TOKEN=replace-during-legacy-migration

# Supabase Edge Function CORS allowlist, comma-separated exact origins.
CITY_SAY_ALLOWED_ORIGINS=https://your-domain.example
