# Copy to .env (gitignored). Never commit real keys.
OPENAI_API_KEY=sk-proj-...
# From https://platform.tripo3d.ai → API Keys (NOT a task_id like tsk_...)
TRIPO_API_KEY=
# From https://www.meshy.ai → API → Generate API Key
MESHY_API_KEY=

# Supabase (leaderboard + city realtime). The anon key is public by design —
# the tables are protected by row-level security. Set these so the key can be
# rotated without a code change.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hub multiplayer (presence + broadcast). Default OFF until city_chat.sql +
# Realtime RLS are confirmed on the project. Set to 1 only then.
VITE_HUB_REALTIME=

TOGETHER_API_KEY=
