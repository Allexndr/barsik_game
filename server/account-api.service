[Unit]
Description=Barsik account and progress API
After=network.target barsik-backend.service
Wants=barsik-backend.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/barsik-backend
ExecStart=/usr/bin/node /var/www/barsik-backend/account-api.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3002
Environment=DB_PATH=/var/www/barsik-backend/data/barsik.db

[Install]
WantedBy=multi-user.target
