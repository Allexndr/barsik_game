{
  "name": "barsik-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:gameplay": "playwright test tests/e2e/gameplay.spec.ts",
    "test:device": "playwright test tests/e2e/device-matrix.spec.ts",
    "test:perf": "playwright test tests/e2e/performance.spec.ts",
    "voice:check": "node scripts/extract-voice-lines.mjs --check"
  },
  "dependencies": {
    "@supabase/realtime-js": "^2.112.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.161.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
