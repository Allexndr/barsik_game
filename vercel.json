{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/model-gallery", "destination": "/model-gallery/index.html" },
    { "source": "/model-gallery/", "destination": "/model-gallery/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    }
  ]
}
